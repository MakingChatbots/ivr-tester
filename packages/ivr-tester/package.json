{
  "name": "ivr-tester",
  "version": "0.2.12",
  "description": "An automated testing framework for IVR call flows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SketchingDev/ivr-tester.git"
  },
  "homepage": "https://github.com/SketchingDev/ivr-tester#ivr-tester",
  "keywords": [
    "IVR",
    "Interactive Voice Response",
    "call flow",
    "call",
    "test",
    "telephony"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run src",
    "clean": "rimraf dist/",
    "build:dtmf-tones": "./generate-dtmf-tones.sh",
    "build": "npm run clean && tsc -p tsconfig.build.json --declaration",
    "postbuild": "npm run copy:dtmf-tones",
    "lint": "biome check .",
    "copy:dtmf-tones": "copyfiles -u 1 src/**/dtmf/**/*.raw dist",
    "tool:audio-server": "node --require ts-node/register tools/audio-server.ts",
    "prepare": "npm run build"
  },
  "files": [
    "/dist"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "debug": "^4.4.3",
    "joi": "^18.0.2",
    "string-similarity": "^4.0.4",
    "twilio": "^5.12.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.1.0",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "get-port": "^7.1.0",
    "ngrok": "^4.3.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-for-expect": "^4.0.0"
  },
  "engines": {
    "node": ">= 10.14.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
