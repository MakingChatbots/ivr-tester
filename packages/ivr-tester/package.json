{
  "name": "ivr-tester",
  "version": "1.0.0-beta.0",
  "description": "An automated testing framework for IVR call flows",
  "license": "MIT",
  "author": "Lucas Woodward",
  "repository": {
    "type": "git",
    "url": "https://github.com/SketchingDev/ivr-tester.git"
  },
  "homepage": "https://github.com/SketchingDev/ivr-tester#ivr-tester",
  "keywords": [
    "IVR",
    "IVR testing",
    "Interactive Voice Response",
    "call flow",
    "call",
    "test",
    "telephony"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run src",
    "test:integration": "vitest run __tests__/integration",
    "clean": "rimraf dist/",
    "build:dtmf-tones": "./generate-dtmf-tones.sh",
    "build": "npm run clean && tsc -p tsconfig.build.json --declaration && npm run copy:dtmf-tones",
    "lint": "biome check --write src/",
    "copy:dtmf-tones": "copyfiles -u 1 src/**/dtmf/**/*.raw dist",
    "open-tunnel": "cloudflared tunnel --metrics localhost:8081 --url http://localhost:8080"
  },
  "files": [
    "/dist"
  ],
  "dependencies": {
    "debug": "^4.4.3",
    "string-similarity": "^4.0.4",
    "twilio": "^5.13.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
