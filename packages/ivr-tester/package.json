{
  "name": "ivr-tester",
  "version": "1.0.0-beta.0",
  "description": "An automated testing framework for IVR call flows",
  "license": "MIT",
  "author": "Lucas Woodward",
  "repository": {
    "type": "git",
    "url": "https://github.com/SketchingDev/ivr-tester.git"
  },
  "homepage": "https://github.com/SketchingDev/ivr-tester#ivr-tester",
  "keywords": [
    "IVR",
    "Interactive Voice Response",
    "call flow",
    "call",
    "test",
    "telephony"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run src",
    "test:integration": "vitest run __tests__/integration",
    "clean": "rimraf dist/",
    "build:dtmf-tones": "./generate-dtmf-tones.sh",
    "build": "npm run clean && tsc -p tsconfig.build.json --declaration && npm run copy:dtmf-tones",
    "lint": "biome check --write src/",
    "copy:dtmf-tones": "copyfiles -u 1 src/**/dtmf/**/*.raw dist"
  },
  "files": [
    "/dist"
  ],
  "dependencies": {
    "debug": "^4.4.3",
    "joi": "^17.13.3",
    "string-similarity": "^4.0.4",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "twilio": "5.13.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "twilio": "^5.12.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
