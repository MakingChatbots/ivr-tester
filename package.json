{
  "name": "root",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w packages/cli",
    "readme:copy": "cp README.md ./packages/ivr-tester/",
    "publish:all": "npm publish --workspaces --access public"
  },
  "engines": {
    "node": ">= 10.14.2"
  }
}
